{
    "name": "kafka4php/framework",
    "description": "Userland framework for kafka4php: typed messages, results, routing and the per-message kernel.",
    "type": "library",
    "keywords": ["kafka", "consumer", "kafka4php"],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Kafka4php\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kafka4php\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress"
    }
}
